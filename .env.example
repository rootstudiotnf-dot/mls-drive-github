# MLS Drive — variables de entorno
#
# Copia este archivo a `.env.local` y rellénalo. NUNCA subas `.env.local` (está en .gitignore).
# Guía paso a paso: docs/SETUP-SUPABASE.md
#
# Reglas:
# - Las variables sin prefijo NEXT_PUBLIC_ son solo de servidor y nunca llegan al navegador.
# - Todo lo que lleve NEXT_PUBLIC_ se publica en el JavaScript del navegador: no pongas secretos ahí.

# URL del proyecto de Supabase (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=

# Clave anónima (anon / publishable). Pública por diseño: la protección la da RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave service role. SECRETA: salta RLS. Solo servidor (acciones de servidor y scripts).
# No la compartas, no la pongas en capturas ni en chats, y no le añadas el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la plataforma, sin barra final (se usa en los enlaces de los correos).
# En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=

# Correo de la primera cuenta owner. Solo lo lee `npm run create-owner`.
OWNER_EMAIL=

# ---------------------------------------------------------------------------
# Almacenamiento (Cloudflare R2). Guía: docs/SETUP-R2.md. TODAS son solo de servidor.
# ---------------------------------------------------------------------------

# ID de la cuenta de Cloudflare.
R2_ACCOUNT_ID=

# Credenciales de un token de API de R2 con acceso de lectura y escritura SOLO a este bucket. SECRETAS.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Nombre del bucket (privado, sin dominio público).
R2_BUCKET=

# Tamaño máximo de una subida, en GB. Por defecto 10.
MAX_UPLOAD_GB=10

# Tamaño de cada parte de las subidas grandes (multipart), en MB. Por defecto 16; mínimo 5.
UPLOAD_PART_SIZE_MB=16

# Precio por GB-mes para estimar costes en /almacenamiento (editable; consulta la tarifa vigente de R2).
R2_PRICE_PER_GB_MONTH=0.015

# (Opcional, solo desarrollo) endpoint S3 alternativo, p. ej. un MinIO local. Si está vacío se usa el de R2.
R2_ENDPOINT=

# Procesado de vídeo (Fase 6) — SOLO servidor
# URL del servicio services/transcoder (sin barra final). Si está vacía, los vídeos se quedan «en cola».
TRANSCODER_URL=
# Secreto compartido con el servicio (mínimo 32 caracteres). Firma las peticiones y los callbacks.
TRANSCODER_HMAC_SECRET=
# Duración máxima de un vídeo, en minutos
VIDEO_MAX_DURATION_MIN=120

# ---------------------------------------------------------------------------
# Vault (Fase 8) — SOLO servidor. Guía: docs/SETUP-VAULT.md
# ---------------------------------------------------------------------------
# Segundo bucket privado y su PROPIO token de API (limitado solo a ese bucket). SECRETOS.
R2_VAULT_BUCKET=
R2_VAULT_ACCESS_KEY_ID=
R2_VAULT_SECRET_ACCESS_KEY=
# (Opcional, solo desarrollo) endpoint S3 alternativo del Vault.
R2_VAULT_ENDPOINT=
# Secreto (mínimo 32 caracteres) para firmar la cookie de desbloqueo del Vault. Sin él, el Vault no se abre.
VAULT_COOKIE_SECRET=
# (Opcional) copia de seguridad del Vault: bucket y credenciales de OTRA cuenta o proveedor (solo scripts/backup-vault.ts).
R2_BACKUP_BUCKET=
R2_BACKUP_ENDPOINT=
R2_BACKUP_ACCESS_KEY_ID=
R2_BACKUP_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Colaboración (Fase 9) — SOLO servidor. Guía: docs/SETUP-COLLAB.md
# ---------------------------------------------------------------------------
# Sal/clave (mínimo 32 caracteres aleatorios) para hashear IPs, firmar la cookie de contraseña de los enlaces y los
# enlaces de baja de los correos. Sin ella, los enlaces externos y los avisos por correo no funcionan.
SHARE_LINK_SALT=
# Correo con la API HTTP de Resend (fetch, sin SDK). Si faltan, los avisos solo llegan a la bandeja interna.
RESEND_API_KEY=
MAIL_FROM="MLS Drive <avisos@tu-dominio.com>"
# Secreto (mínimo 16 caracteres) del cron de avisos: Authorization: Bearer <valor> (Vercel Cron lo envía solo).
CRON_SECRET=

# ---------------------------------------------------------------------------
# Operación (Fase 10) — SOLO servidor. Guías: docs/BACKUPS.md y docs/DESPLIEGUE.md
# ---------------------------------------------------------------------------
# Cuota de almacenamiento en GB (la de tu plan de R2). Con ella, /admin/estado y las alertas avisan al pasar del 80 %.
STORAGE_QUOTA_GB=
# Cadena de conexión de Postgres (Supabase → Project Settings → Database). SOLO para scripts/backup-db.ts: no la pongas en Vercel.
SUPABASE_DB_URL=
# Retención de los volcados de base de datos, en días (por defecto 30).
BACKUP_RETENTION_DAYS=30
# Restauración (scripts/restore-files.ts): bucket NUEVO y su token de escritura. Solo al recuperar.
RESTORE_BUCKET=
RESTORE_ENDPOINT=
RESTORE_ACCESS_KEY_ID=
RESTORE_SECRET_ACCESS_KEY=
# Pon 1 para mostrar la página de mantenimiento (503) a todo el mundo salvo a los procesos internos. Quítala al terminar.
MAINTENANCE_MODE=
